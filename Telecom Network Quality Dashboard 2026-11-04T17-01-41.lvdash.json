{
  "datasets": [
    {
      "name": "region_sla",
      "displayName": "Regional SLA Summary",
      "config": {
        "source": "capstone6_telecom.gold.gold_region_sla_summary",
        "measures": [
          {
            "name": "regions",
            "expr": "COUNT(1)"
          },
          {
            "name": "measurement_count",
            "expr": "SUM(measurement_count)"
          },
          {
            "name": "avg_availability_pct",
            "expr": "SUM(avg_availability_pct * measurement_count) / SUM(CASE WHEN avg_availability_pct IS NOT NULL THEN measurement_count END)",
            "displayName": "Avg availability (%)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "min_availability_pct",
            "expr": "MIN(min_availability_pct)",
            "displayName": "Min availability (%)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_latency_ms",
            "expr": "SUM(avg_latency_ms * measurement_count) / SUM(CASE WHEN avg_latency_ms IS NOT NULL THEN measurement_count END)",
            "displayName": "Avg latency (ms)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "displayName": "P95 latency (ms)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "p95_latency_ms",
            "expr": "MAX(p95_latency_ms)",
            "comment": "Per-region p95; when several regions are grouped this shows the highest regional p95"
          },
          {
            "name": "avg_packet_loss_pct",
            "expr": "SUM(avg_packet_loss_pct * measurement_count) / SUM(CASE WHEN avg_packet_loss_pct IS NOT NULL THEN measurement_count END)",
            "displayName": "Avg packet loss (%)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_throughput_mbps",
            "expr": "SUM(avg_throughput_mbps * measurement_count) / SUM(CASE WHEN avg_throughput_mbps IS NOT NULL THEN measurement_count END)",
            "displayName": "Avg throughput (Mbps)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "outage_count",
            "expr": "SUM(outage_count)"
          },
          {
            "name": "total_outage_minutes",
            "expr": "SUM(total_outage_minutes)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "max",
                "places": 1.0
              }
            }
          },
          {
            "name": "outages_with_telemetry",
            "expr": "SUM(outages_with_telemetry)"
          },
          {
            "name": "outages_with_complaints",
            "expr": "SUM(outages_with_complaints)"
          },
          {
            "name": "complaint_count",
            "expr": "SUM(complaint_count)"
          }
        ],
        "version": "1.1",
        "comment": "Network SLA summary per region (one row per region). SLA targets are not defined, so no pass/fail is computed.",
        "dimensions": [
          {
            "expr": "region_id"
          },
          {
            "expr": "region_name"
          },
          {
            "expr": "sla_tier"
          },
          {
            "expr": "service_zone"
          },
          {
            "expr": "market_segment"
          }
        ]
      }
    },
    {
      "name": "outage_impact",
      "displayName": "Outage Impact",
      "config": {
        "source": "capstone6_telecom.gold.fact_outage_impact",
        "measures": [
          {
            "name": "outages",
            "expr": "COUNT(1)"
          },
          {
            "name": "outages_with_telemetry",
            "expr": "SUM(CASE WHEN has_telemetry_evidence THEN 1 ELSE 0 END)"
          },
          {
            "name": "outages_with_complaints",
            "expr": "SUM(CASE WHEN has_customer_impact THEN 1 ELSE 0 END)"
          },
          {
            "name": "share_with_telemetry",
            "expr": "MEASURE(outages_with_telemetry) / MEASURE(outages)",
            "displayName": "Share with telemetry evidence",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "share_with_customer_impact",
            "expr": "MEASURE(outages_with_complaints) / MEASURE(outages)",
            "displayName": "Share with customer impact",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "displayName": "Avg latency delta (ms)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_latency_delta_ms",
            "expr": "AVG(latency_delta_ms)",
            "comment": "Average of window minus baseline latency, over outages with telemetry evidence"
          },
          {
            "name": "avg_availability_delta_pct",
            "expr": "AVG(availability_delta_pct)",
            "displayName": "Avg availability delta (pct points)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 3.0
              }
            }
          },
          {
            "name": "avg_packet_loss_delta_pct",
            "expr": "AVG(packet_loss_delta_pct)",
            "displayName": "Avg packet loss delta (pct points)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 3.0
              }
            }
          },
          {
            "name": "avg_throughput_delta_mbps",
            "expr": "AVG(throughput_delta_mbps)",
            "displayName": "Avg throughput delta (Mbps)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "window_complaints",
            "expr": "SUM(window_complaint_count)"
          },
          {
            "name": "avg_outage_duration_minutes",
            "expr": "AVG(outage_duration_minutes)",
            "displayName": "Avg outage duration (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Outage-to-telemetry correlation (one row per outage). Deltas are impact window minus baseline for the same tower.",
        "dimensions": [
          {
            "expr": "outage_id"
          },
          {
            "expr": "outage_type"
          },
          {
            "expr": "severity"
          },
          {
            "expr": "root_cause_code"
          },
          {
            "expr": "region_name"
          },
          {
            "expr": "sla_tier"
          },
          {
            "expr": "outage_date"
          },
          {
            "expr": "has_telemetry_evidence"
          },
          {
            "expr": "has_customer_impact"
          }
        ]
      }
    },
    {
      "name": "network_quality_daily",
      "displayName": "Network Quality Daily",
      "config": {
        "source": "capstone6_telecom.gold.gold_network_quality_daily",
        "measures": [
          {
            "name": "measurement_count",
            "expr": "SUM(measurement_count)"
          },
          {
            "name": "outlier_measurement_count",
            "expr": "SUM(outlier_measurement_count)"
          },
          {
            "displayName": "Avg latency (ms, excl. outliers)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_latency_ms",
            "expr": "SUM(avg_latency_ms * (measurement_count - COALESCE(outlier_measurement_count, 0))) / SUM(CASE WHEN avg_latency_ms IS NOT NULL THEN measurement_count - COALESCE(outlier_measurement_count, 0) END)",
            "comment": "Measurement-weighted average latency excluding IQR outlier measurements"
          },
          {
            "name": "avg_latency_ms_incl_outliers",
            "expr": "SUM(avg_latency_ms_incl_outliers * measurement_count) / SUM(CASE WHEN avg_latency_ms_incl_outliers IS NOT NULL THEN measurement_count END)",
            "displayName": "Avg latency (ms, incl. outliers)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "displayName": "Avg availability (%)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_availability_pct",
            "expr": "SUM(avg_availability_pct * measurement_count) / SUM(CASE WHEN avg_availability_pct IS NOT NULL THEN measurement_count END)",
            "comment": "Measurement-weighted average availability, in percent (0-100)"
          },
          {
            "displayName": "Avg packet loss (%)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_packet_loss_pct",
            "expr": "SUM(avg_packet_loss_pct * measurement_count) / SUM(CASE WHEN avg_packet_loss_pct IS NOT NULL THEN measurement_count END)",
            "comment": "Measurement-weighted average packet loss, in percent (0-100)"
          },
          {
            "name": "avg_throughput_mbps",
            "expr": "SUM(avg_throughput_mbps * measurement_count) / SUM(CASE WHEN avg_throughput_mbps IS NOT NULL THEN measurement_count END)",
            "displayName": "Avg throughput (Mbps)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "outage_count",
            "expr": "SUM(outage_count)"
          },
          {
            "name": "complaint_count",
            "expr": "SUM(complaint_count)"
          }
        ],
        "version": "1.1",
        "comment": "Daily network quality per region (one row per region_id + summary_date). Averages are re-weighted by measurement counts so they stay correct when rolled up.",
        "dimensions": [
          {
            "expr": "summary_date"
          },
          {
            "expr": "region_id"
          },
          {
            "expr": "region_name"
          },
          {
            "expr": "service_zone"
          },
          {
            "expr": "sla_tier"
          }
        ]
      }
    },
    {
      "name": "pipeline_validation",
      "displayName": "Pipeline Validation",
      "config": {
        "source": "SELECT layer, check_group, check_name, table_name, comparison, expected_value, actual_value, blocking, status, validated_at\nFROM capstone6_telecom.bronze.bronze_validation_summary\nUNION ALL\nSELECT layer, check_group, check_name, table_name, comparison, expected_value, actual_value, blocking, status, validated_at\nFROM capstone6_telecom.silver.silver_validation_summary\nUNION ALL\nSELECT layer, check_group, check_name, table_name, comparison, expected_value, actual_value, blocking, status, validated_at\nFROM capstone6_telecom.gold.gold_validation_summary",
        "measures": [
          {
            "name": "checks",
            "expr": "COUNT(1)"
          },
          {
            "name": "passed_checks",
            "expr": "SUM(CASE WHEN status = 'PASS' THEN 1 ELSE 0 END)"
          },
          {
            "name": "failed_checks",
            "expr": "SUM(CASE WHEN status = 'FAIL' THEN 1 ELSE 0 END)"
          },
          {
            "name": "warning_checks",
            "expr": "SUM(CASE WHEN status = 'WARN' THEN 1 ELSE 0 END)"
          },
          {
            "name": "pass_rate",
            "expr": "MEASURE(passed_checks) / MEASURE(checks)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "last_validated_at",
            "expr": "MAX(validated_at)",
            "format": {
              "type": "date_time",
              "dateFormat": "year_month_day",
              "timeFormat": "locale_hour_minute"
            }
          }
        ],
        "version": "1.1",
        "comment": "Pipeline validation results written by tests/06_Pipeline_Validation (latest run only).",
        "dimensions": [
          {
            "expr": "layer"
          },
          {
            "expr": "check_group"
          },
          {
            "expr": "check_name"
          },
          {
            "expr": "table_name"
          },
          {
            "expr": "comparison"
          },
          {
            "expr": "expected_value"
          },
          {
            "expr": "actual_value"
          },
          {
            "expr": "blocking"
          },
          {
            "expr": "status"
          },
          {
            "expr": "validated_at"
          }
        ]
      }
    }
  ],
